# Copy to .env and fill in real values. Never commit .env.
POSTGRES_DB=iemas
POSTGRES_USER=iemas
POSTGRES_PASSWORD=change_me

# Generate a strong random secret (32+ chars), e.g. `openssl rand -base64 48`
JWT_SECRET=

# Separate signing secret for Windows Agent tokens (§69 — Agent identity must be entirely
# distinct from CMS user identity; must NOT be the same value as JWT_SECRET).
AGENT_JWT_SECRET=

# Base64-encoded 256-bit key for AES-256-GCM credential encryption, e.g. `openssl rand -base64 32`
# Rotating this key without a migration will make existing stored credentials undecryptable.
CREDENTIAL_ENCRYPTION_KEY=

# Bootstrap Super Administrator account (created on first run only)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# CMS origin allowed to call the API (CORS)
CORS_ORIGIN=http://localhost:5173

# OpenRouter API key for AI email classification (Phase 4). Get one at https://openrouter.ai/keys.
# Left blank, AI classification calls fail cleanly and messages go to REVIEW_REQUIRED instead of
# being lost — see IEMAS_Build_Progress_Tracker.md Phase 4 for the non-fatal-failure guarantee.
OPENROUTER_API_KEY=
AI_CLASSIFICATION_ENABLED=true

ASPNETCORE_ENVIRONMENT=Production

# --- Production deployment only (docker-compose.prod.yml) ---
# The public DNS name this host is reachable at. Caddy uses this to request a
# real Let's Encrypt certificate automatically and as the CORS origin default.
# Leave unset for an IP-only/domain-less deployment (see deploy/Caddyfile's
# :80 fallback block) — automatic HTTPS will not be available in that case.
DOMAIN=

# Where the built CMS's API calls are sent. Left at the default, requests go
# to the same origin's /api/v1 (i.e. through Caddy), which is correct for
# the standard single-host deployment and rarely needs changing.
VITE_API_BASE_URL=/api/v1
