# Single-host production reverse proxy: terminates TLS and routes to the CMS
# static site (default) and the API (under /api/*, matching web-cms's
# VITE_API_BASE_URL=/api/v1 build-time default) and the SignalR hub (/hubs/*,
# upgraded for WebSocket).
#
# {$DOMAIN} must be a real DNS name pointing at this host for Caddy to obtain
# a Let's Encrypt certificate automatically. It can also be the server's IP
# address on an internal network (e.g. DOMAIN=172.16.2.68): Caddy then issues
# its own certificate for that IP, and Windows Agents connect to
# https://<ip>:<PROXY_HTTPS_PORT> with "Allow self-signed certificates" ticked.

{
	# Clients connecting by IP address send no server name, so without this
	# Caddy cannot choose a certificate and the HTTPS handshake fails.
	default_sni {$DOMAIN}
}

{$DOMAIN} {
	encode gzip

	handle /api/* {
		reverse_proxy api:8080
	}

	handle /hubs/* {
		reverse_proxy api:8080
	}

	handle {
		reverse_proxy web:80
	}
}

# Fallback for deployments with no public DNS name yet (IP-only access,
# internal network, or before DNS is cut over). Caddy cannot issue a real
# certificate without a domain, so this serves plain HTTP on the host's
# port 80 — intended as a bridge, not a permanent production configuration.
# Remove this block once {$DOMAIN} is set and reachable.
:80 {
	encode gzip

	handle /api/* {
		reverse_proxy api:8080
	}

	handle /hubs/* {
		reverse_proxy api:8080
	}

	handle {
		reverse_proxy web:80
	}
}
