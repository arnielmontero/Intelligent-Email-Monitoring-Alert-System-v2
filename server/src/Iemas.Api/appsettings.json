{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "Iemas",
    "Audience": "IemasClients",
    "Secret": "",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 14
  },
  "AgentJwt": {
    "Issuer": "Iemas.Agent",
    "Audience": "IemasAgents",
    "Secret": "",
    "AccessTokenMinutes": 15,
    "RegistrationKeyDays": 365
  },
  "Bootstrap": {
    "AdminEmail": "",
    "AdminPassword": ""
  },
  "CredentialEncryption": {
    "Key": "",
    "KeyId": "v1"
  },
  "AiClassification": {
    "Enabled": true,
    "CronSchedule": "*/2 * * * *",
    "BatchSize": 25,
    "OpenRouter": {
      "BaseUrl": "https://openrouter.ai/api/v1",
      "ApiKey": "",
      "SiteUrl": "",
      "SiteName": "IEMAS"
    }
  },
  "CaseWorkflow": {
    "Enabled": true,
    "CronSchedule": "*/2 * * * *",
    "BatchSize": 25
  },
  "ReplyVerification": {
    "Enabled": true,
    "CronSchedule": "*/5 * * * *",
    "BatchSize": 25
  },
  "ReminderEngine": {
    "Enabled": true,
    "CronSchedule": "*/5 * * * *",
    "BatchSize": 50
  },
  "EscalationEngine": {
    "Enabled": true,
    "CronSchedule": "*/10 * * * *",
    "BatchSize": 50
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  }
}
