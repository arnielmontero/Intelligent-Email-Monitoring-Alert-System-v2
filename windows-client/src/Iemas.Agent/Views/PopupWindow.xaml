<Window x:Class="Iemas.Agent.Views.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IEMAS" Width="360" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        AllowsTransparency="True" Background="Transparent">
    <!-- IEMAS's own alert: always on top in the bottom-right corner, so Windows notification settings or
         Do not disturb can't hide it. Stays until the employee acts on it or dismisses it. -->
    <Border Background="White" BorderBrush="#2563EB" BorderThickness="0,4,0,0" CornerRadius="6" Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.35"/>
        </Border.Effect>
        <StackPanel Margin="16,12,16,14">
            <Grid>
                <TextBlock Text="IEMAS" FontWeight="Bold" Foreground="#2563EB" FontSize="11"/>
                <Button Content="✕" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Padding="4,0"
                        Cursor="Hand" ToolTip="Dismiss" Click="Dismiss_Click"/>
            </Grid>
            <TextBlock x:Name="TitleText" FontWeight="Bold" FontSize="14" Foreground="#111827" TextWrapping="Wrap" Margin="0,4,0,4"/>
            <TextBlock x:Name="MessageText" Foreground="#374151" TextWrapping="Wrap" MaxHeight="120"/>
            <TextBlock x:Name="CaseText" Foreground="#6B7280" FontSize="11" Margin="0,6,0,0"/>
            <StackPanel x:Name="ButtonsPanel" Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="Open Case" Background="#2563EB" Foreground="White" BorderThickness="0" Padding="12,6"
                        Margin="0,0,8,0" Cursor="Hand" Click="OpenCase_Click"/>
                <Button Content="Acknowledge" Background="#E5E7EB" Foreground="#111827" BorderThickness="0" Padding="12,6"
                        Cursor="Hand" Click="Acknowledge_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
