<Window x:Class="Iemas.Agent.Views.CaseDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inquiry - IEMAS" Icon="pack://application:,,,/IemasAgent;component/Assets/iemas.ico"
        Width="500" SizeToContent="Height" MaxHeight="780" MinWidth="420"
        WindowStartupLocation="CenterOwner" Background="#F3F4F6" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <!-- Tooltips: appear quickly, stay long enough to read, and wrap. -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#111827"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="300" LineHeight="18"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BaseBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="250"/>
            <Setter Property="ToolTipService.ShowDuration" Value="30000"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource BaseBtn}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="SuccessBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#059669"/>
        </Style>
        <Style x:Key="SoftBtn" TargetType="Button" BasedOn="{StaticResource BaseBtn}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource SoftBtn}">
            <Setter Property="Foreground" Value="#B91C1C"/>
            <Setter Property="BorderBrush" Value="#FCA5A5"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">

            <!-- 1. What is this? -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock x:Name="CaseNumberText" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280"/>
                    <TextBlock x:Name="SubjectText" FontSize="17" FontWeight="Bold" Foreground="#111827" TextWrapping="Wrap" Margin="0,4,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="From" Foreground="#6B7280" Margin="0,0,12,2"/>
                        <TextBlock x:Name="CustomerText" Grid.Column="1" Foreground="#111827" TextWrapping="Wrap"/>
                        <TextBlock Text="Received" Grid.Row="1" Foreground="#6B7280" Margin="0,0,12,0"/>
                        <TextBlock x:Name="ReceivedText" Grid.Row="1" Grid.Column="1" Foreground="#111827"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 2. Where does it stand, and what do I do now? -->
            <Border x:Name="StatusCard" CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock x:Name="StatusLabel" FontSize="15" FontWeight="Bold"/>
                    <TextBlock x:Name="NextStepText" TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="19"/>
                </StackPanel>
            </Border>

            <!-- 2b. Only when IEMAS thinks it is resolved: the agent confirms or rejects. -->
            <Border x:Name="ConfirmCard" Style="{StaticResource Card}" BorderBrush="#F59E0B" BorderThickness="1" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Is this inquiry resolved?" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                    <WrapPanel>
                        <Button Content="✓  Yes, it's resolved" Style="{StaticResource SuccessBtn}" Tag="ConfirmResolved" Click="Action_Click"
                                ToolTip="The customer got what they needed. IEMAS stops watching this inquiry: no more reminders and no escalation. It moves out of your list."/>
                        <Button Content="Not resolved yet" Style="{StaticResource SoftBtn}" Tag="RejectResolution" Click="Action_Click"
                                ToolTip="Something is still open. IEMAS keeps watching the conversation and reminds you as usual."/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- 3. Main actions -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="WHAT DO YOU WANT TO DO?" Style="{StaticResource SectionTitle}"/>
                    <WrapPanel>
                        <Button x:Name="ReplyButton" Content="✉  Reply in email" Style="{StaticResource PrimaryBtn}" Click="Reply_Click"
                                ToolTip="Opens your email program (for example Outlook). Answer the customer's email from this mailbox. IEMAS notices your reply by itself, so you don't need to click anything else afterwards."/>
                        <Button x:Name="ResolveButton" Content="✓  Mark as resolved" Style="{StaticResource SuccessBtn}" Tag="ConfirmResolved" Click="Action_Click"
                                ToolTip="Use this when the customer's request is fully handled (answered, quotation sent, problem fixed). IEMAS stops watching it: no more reminders and no escalation."/>
                    </WrapPanel>

                    <TextBlock Text="OTHER OPTIONS" Style="{StaticResource SectionTitle}" Margin="0,8,0,8"/>
                    <UniformGrid Columns="2">
                        <Button x:Name="WorkingButton" Content="I'm working on it" Style="{StaticResource SoftBtn}" Tag="WillHandle" Click="Action_Click"
                                ToolTip="Lets IEMAS and your manager see you have picked this up. Reminders continue until your reply to the customer is found."/>
                        <Button Content="Waiting on a colleague" Style="{StaticResource SoftBtn}" Tag="WaitingForInternal" Click="Action_Click"
                                ToolTip="You need information from someone inside the company before you can answer. IEMAS gives you more time and moves this to your Waiting list."/>
                        <Button Content="Remind me in 1 hour" Style="{StaticResource SoftBtn}" Tag="RemindLater" Click="Action_Click"
                                ToolTip="IEMAS pops this inquiry up again in 1 hour. Normal reminders and deadlines still apply."/>
                        <Button Content="Not a customer inquiry" Style="{StaticResource DangerBtn}" Tag="Cancel" Click="Action_Click"
                                ToolTip="Use this if the email was flagged by mistake (spam, newsletter, personal or internal mail). It is closed, removed from your list, and no reminders follow."/>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- 4. Optional note -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="ADD A NOTE (OPTIONAL)" Style="{StaticResource SectionTitle}"/>
                    <TextBox x:Name="CommentTextBox" AcceptsReturn="True" MinHeight="54" TextWrapping="Wrap" Padding="8,6"
                             BorderBrush="#D1D5DB" VerticalScrollBarVisibility="Auto"
                             ToolTip="For example: &quot;Called the customer, sending the quotation tomorrow.&quot; Your manager can read it in IEMAS. It is not sent to the customer."/>
                    <Button Content="Save note" Style="{StaticResource SoftBtn}" HorizontalAlignment="Left" Margin="0,8,0,0" Click="SubmitComment_Click"
                            ToolTip="Saves the note in this inquiry's history. It does not change the status and is not sent to the customer."/>
                </StackPanel>
            </Border>

            <!-- 5. Result of the last click -->
            <Border x:Name="ResultBar" CornerRadius="6" Padding="12,8" Visibility="Collapsed">
                <TextBlock x:Name="ResultText" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
