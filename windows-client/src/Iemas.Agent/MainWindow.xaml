<Window x:Class="Iemas.Agent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Iemas.Agent"
        mc:Ignorable="d"
        Title="IEMAS Agent" Height="600" Width="480"
        Icon="pack://application:,,,/IemasAgent;component/Assets/iemas.ico"
        Closing="MainWindow_Closing"
        StateChanged="MainWindow_StateChanged">
    <Window.Resources>
        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="ToolTipService.InitialShowDelay" Value="250"/>
            <Setter Property="ToolTipService.ShowDuration" Value="30000"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="ToolTipService.InitialShowDelay" Value="250"/>
            <Setter Property="ToolTipService.ShowDuration" Value="30000"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#6B7280"/>
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#111827"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="300"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HelpHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Margin" Value="0,16,0,6"/>
        </Style>
        <Style x:Key="HelpText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="LineHeight" Value="18"/>
        </Style>
        <Style x:Key="HelpTerm" TargetType="TextBlock" BasedOn="{StaticResource HelpText}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style x:Key="HelpCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16,4,16,12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>
    <Grid Background="#F3F4F6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: §9 "IEMAS   John Smith / ● Connected" -->
        <Border Grid.Row="0" Background="#111827" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="IEMAS" Foreground="White" FontSize="18" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Ellipse Width="8" Height="8" Fill="{Binding StatusColor}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusText}" Foreground="#D1D5DB" Margin="6,0,0,0" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding EmployeeName}" Foreground="White" VerticalAlignment="Center" FontSize="14"/>
            </Grid>
        </Border>

        <!-- Body: switches between Action Required / Waiting / History / Settings via ContentControl -->
        <Grid Grid.Row="1">
            <!-- Not registered / pending / rejected / error states -->
            <Border x:Name="OnboardingPanel" Background="White" Margin="16" CornerRadius="6" Padding="20" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="OnboardingTitle" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock x:Name="OnboardingMessage" TextWrapping="Wrap" Foreground="#4B5563" Margin="0,0,0,16"/>
                    <StackPanel x:Name="RegistrationForm">
                        <TextBlock Text="Email Address (must be an enrolled IEMAS mailbox)" FontSize="12" Foreground="#4B5563"/>
                        <TextBox x:Name="EmailTextBox" Margin="0,4,0,10" Padding="6"/>
                        <TextBlock Text="Client/Agent Name" FontSize="12" Foreground="#4B5563"/>
                        <TextBox x:Name="ClientNameTextBox" Margin="0,4,0,10" Padding="6"/>
                        <Button Content="Register" Style="{StaticResource ActionButton}" HorizontalAlignment="Left" Click="RegisterButton_Click"/>
                        <TextBlock x:Name="RegistrationError" Foreground="#DC2626" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Action Required / Waiting lists -->
            <Grid x:Name="CaseListPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="ListHeader" Grid.Row="0" Text="ACTION REQUIRED" FontWeight="Bold" FontSize="13" Foreground="#374151" Margin="16,12,16,4"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="CaseItemsControl" Margin="16,0,16,16">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Border Background="{Binding StatusBackground}" CornerRadius="10" Padding="8,2" HorizontalAlignment="Left" Margin="0,0,0,6">
                                            <TextBlock Text="{Binding StatusLabel}" Foreground="{Binding StatusForeground}" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                        <TextBlock Text="{Binding CustomerDisplay}" FontWeight="Bold" FontSize="14"/>
                                        <TextBlock Text="{Binding Subject}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding ReceivedSummary}" Foreground="#6B7280" FontSize="11" Margin="0,4,0,10"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Open" Style="{StaticResource ActionButton}" Tag="{Binding}" Click="OpenCaseButton_Click"
                                                    ToolTip="Open this inquiry: see where it stands, what to do next, and mark it resolved when done."/>
                                            <Button Content="Add note" Style="{StaticResource SecondaryButton}" Tag="{Binding}" Click="AddUpdateButton_Click"
                                                    ToolTip="Write a short note for your manager (for example: Called the customer). It is not sent to the customer."/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- History -->
            <Grid x:Name="HistoryPanel" Visibility="Collapsed">
                <TextBlock Text="History is not available in the Agent yet. Completed and cancelled Cases, with their full timeline, can be seen by an administrator in the IEMAS CMS (Case History)." Foreground="#6B7280" Margin="16" TextWrapping="Wrap"/>
            </Grid>

            <!-- Help: how the Agent and IEMAS work, from the employee's side. Reachable before registration too. -->
            <ScrollViewer x:Name="HelpPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,12,16,16">
                    <TextBlock Text="HELP" FontWeight="Bold" FontSize="13" Foreground="#374151" Margin="0,0,0,8"/>

                    <Border Style="{StaticResource HelpCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource HelpHeading}" Text="What this app does"/>
                            <TextBlock Style="{StaticResource HelpText}" Text="IEMAS (Intelligent Email Monitoring &amp; Alert System) watches the company mailbox you own. When a customer email needs a reply, IEMAS creates a Case for it and this app tells you with a pop-up. It keeps reminding you until your reply is found in the mailbox's Sent folder, and escalates the Case if nobody answers."/>
                            <TextBlock Style="{StaticResource HelpText}" Text="Keep the app running: closing the window only hides it to the system tray (the IEMAS icon near the clock). Pop-ups appear while the app is running and connected. Pop-ups missed while it was closed or offline are shown when it connects again (the last 5 from the past 24 hours, for Cases that still need you), and every open Case appears in the lists straight away."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource HelpCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource HelpHeading}" Text="How a customer email reaches you"/>
                            <TextBlock Style="{StaticResource HelpText}" Text="1. IEMAS checks your mailbox for new email every minute."/>
                            <TextBlock Style="{StaticResource HelpText}" Text="2. The AI reads it straight away: is it a real business email, and does it need a reply? Newsletters, auto-replies and similar do not become Cases."/>
                            <TextBlock Style="{StaticResource HelpText}" Text="3. If it needs a reply, a Case is created and you get a pop-up. Follow-up emails from the same customer about the same topic are added to the same Case. This usually happens within about a minute of the email arriving (a little longer if the AI service is slow)."/>
                            <TextBlock Style="{StaticResource HelpText}" Text="4. Every 5 minutes IEMAS looks in the mailbox's Sent folder for your reply. Once it is found, the Case is marked replied and reminders stop."/>
                            <TextBlock Style="{StaticResource HelpText}" Text="5. No reply yet? You get reminder pop-ups (how often is set by your administrator). After enough reminders the Case becomes Escalated and your supervisor's details are recorded for it."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource HelpCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource HelpHeading}" Text="The status light (top left)"/>
                            <TextBlock Style="{StaticResource HelpTerm}" Text="● Connected (green)"/>
                            <TextBlock Style="{StaticResource HelpText}" Text="Everything works; pop-ups arrive straight away."/>
                            <TextBlock Style="{StaticResource HelpTerm}" Text="Connecting... / Disconnected"/>
                            <TextBlock Style="{StaticResource HelpText}" Text="The app is trying to reach the IEMAS server. It keeps retrying by itself. If it stays like this, check your network and the Server URL in Settings."/>
                            <TextBlock Style="{StaticResource HelpTerm}" Text="Not Registered / Awaiting Approval / Registration Rejected"/>
                            <TextBlock Style="{StaticResource HelpText}" Text="This PC is not linked to you yet - see First-time setup below."/>
                            <TextBlock Style="{StaticResource HelpTerm}" Text="Error"/>
                            <TextBlock Style="{StaticResource HelpText}" Text="The server no longer accepts this PC (for example it was revoked by an administrator). Register again."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource HelpCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource HelpHeading}" Text="First-time setup"/>
                            <TextBlock Style="{StaticResource HelpText}" Text="1. Open Settings and check the Server URL your administrator gave you (for example https://server:8443). Tick &quot;Allow self-signed certificates&quot; only if your administrator tells you to. Save."/>
                            <TextBlock Style="{StaticResource HelpText}" Text="2. On the Register screen enter the company email address IEMAS watches for you, and a name for this PC (your computer name is filled in). Click Register."/>
                            <TextBlock Style="{StaticResource HelpText}" Text="3. The status shows Awaiting Approval. An administrator approves the PC in the IEMAS CMS (Windows Agents). The app notices within a few seconds and connects by itself - no codes or keys to copy."/>
                            <TextBlock Style="{StaticResource HelpText}" Text="4. Tick &quot;Start with Windows&quot; in Settings so you never miss an alert."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource HelpCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource HelpHeading}" Text="Pop-ups"/>
                            <TextBlock Style="{StaticResource HelpText}" Text="You get a pop-up for a new Case, for reminders, when a Case is overdue, just before it escalates, and when it has escalated. It is an IEMAS window in the bottom-right corner of the screen, always on top, with a short sound; it stays until you choose Open Case, Acknowledge or close it (x). Several pop-ups stack upwards. A copy is also kept in the Windows notification centre."/>
                            <TextBlock Style="{StaticResource HelpTerm}" Text="Open Case"/>
                            <TextBlock Style="{StaticResource HelpText}" Text="Opens the Case in this app, where you can act on it."/>
                            <TextBlock Style="{StaticResource HelpTerm}" Text="Acknowledge"/>
                            <TextBlock Style="{StaticResource HelpText}" Text="Tells IEMAS you have seen it. This is only recorded - it does not count as a reply and does not stop reminders."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource HelpCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource HelpHeading}" Text="The tabs"/>
                            <TextBlock Style="{StaticResource HelpTerm}" Text="Action Required"/>
                            <TextBlock Style="{StaticResource HelpText}" Text="Every open Case that still needs you: new, being worked on, overdue or escalated. Each card shows the customer, the subject, when it arrived, how many emails it has and the Case number; its status is shown when it is not simply waiting for action."/>
                            <TextBlock Style="{StaticResource HelpTerm}" Text="Waiting"/>
                            <TextBlock Style="{StaticResource HelpText}" Text="Cases you marked as waiting for the customer or for a colleague. No reminders are sent for these."/>
                            <TextBlock Style="{StaticResource HelpTerm}" Text="History"/>
                            <TextBlock Style="{StaticResource HelpText}" Text="Not available in the app yet; finished Cases can be looked up by an administrator in the IEMAS CMS."/>
                            <TextBlock Style="{StaticResource HelpTerm}" Text="Open Email"/>
                            <TextBlock Style="{StaticResource HelpText}" Text="Opens your email program (for example Outlook) so you can reply. Always reply from the same mailbox the customer wrote to - IEMAS finds your reply in that mailbox's Sent folder."/>
                            <TextBlock Style="{StaticResource HelpTerm}" Text="Settings"/>
                            <TextBlock Style="{StaticResource HelpText}" Text="Server URL, certificates, Start with Windows, and Sign Out / Re-register. The app version is shown at the bottom."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource HelpCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource HelpHeading}" Text="Working on an inquiry"/>
                            <TextBlock Style="{StaticResource HelpText}" Text="Click Open on an inquiry. The coloured box tells you where it stands and what to do next. Hover over any button to see what it does."/>
                            <TextBlock Style="{StaticResource HelpTerm}" Text="Reply in email"/>
                            <TextBlock Style="{StaticResource HelpText}" Text="Opens your email program. Reply to the customer's email from the same mailbox. IEMAS finds your reply by itself within about 5 minutes; you do not need to click anything afterwards."/>
                            <TextBlock Style="{StaticResource HelpTerm}" Text="Mark as resolved"/>
                            <TextBlock Style="{StaticResource HelpText}" Text="The customer's request is fully handled. IEMAS stops watching it: no more reminders, no escalation. A first reply alone does not close an inquiry - IEMAS keeps watching the conversation until you mark it resolved."/>
                            <TextBlock Style="{StaticResource HelpTerm}" Text="Looks resolved - please confirm"/>
                            <TextBlock Style="{StaticResource HelpText}" Text="IEMAS thinks the conversation is finished. Click Yes if that is right, or Not resolved yet if something is still open. IEMAS never closes an inquiry by itself."/>
                            <TextBlock Style="{StaticResource HelpTerm}" Text="I'm working on it"/>
                            <TextBlock Style="{StaticResource HelpText}" Text="Shows you have picked it up. Reminders continue until your reply is found."/>
                            <TextBlock Style="{StaticResource HelpTerm}" Text="Waiting on a colleague"/>
                            <TextBlock Style="{StaticResource HelpText}" Text="You need information from someone in the company first. The inquiry moves to the Waiting tab and you get more time."/>
                            <TextBlock Style="{StaticResource HelpTerm}" Text="Remind me in 1 hour"/>
                            <TextBlock Style="{StaticResource HelpText}" Text="Pops the inquiry up again in an hour. Deadlines still apply."/>
                            <TextBlock Style="{StaticResource HelpTerm}" Text="Not a customer inquiry"/>
                            <TextBlock Style="{StaticResource HelpText}" Text="For emails flagged by mistake (spam, newsletters, personal or internal mail). It is closed and leaves your list."/>
                            <TextBlock Style="{StaticResource HelpTerm}" Text="Add a note"/>
                            <TextBlock Style="{StaticResource HelpText}" Text="A short note for your manager, kept in the inquiry's history. It is never sent to the customer."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource HelpCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource HelpHeading}" Text="The tray icon"/>
                            <TextBlock Style="{StaticResource HelpText}" Text="Closing or minimising the window hides it; the app keeps running. Double-click the IEMAS icon near the clock, or right-click it and choose Open IEMAS, to bring the window back. Right-click also offers Settings, Help and Exit. Exit stops the app: you get no pop-ups until you start it again."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource HelpCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource HelpHeading}" Text="Something is not right?"/>
                            <TextBlock Style="{StaticResource HelpTerm}" Text="I replied but still get reminders"/>
                            <TextBlock Style="{StaticResource HelpText}" Text="Wait up to 5 minutes for the Sent-folder check. Make sure you replied from the mailbox the customer wrote to, by replying to their email (not a new email). If you answered by phone or from another address, complete the Case with the matching reason."/>
                            <TextBlock Style="{StaticResource HelpTerm}" Text="A customer email did not become a Case"/>
                            <TextBlock Style="{StaticResource HelpText}" Text="Allow a few minutes. The AI may have decided it needs no reply, or the sender may be on the ignored list. Ask your administrator to check Case Workflow in the CMS."/>
                            <TextBlock Style="{StaticResource HelpTerm}" Text="No pop-ups appear"/>
                            <TextBlock Style="{StaticResource HelpText}" Text="Check the status light is green. The IEMAS pop-up does not depend on Windows notification settings or Do not disturb. If the light is not green the app reconnects by itself within about a minute; pop-ups missed meanwhile are shown when it does. Make sure the Case is yours: pop-ups go to the owner of the mailbox the email arrived in."/>
                            <TextBlock Style="{StaticResource HelpTerm}" Text="Registration fails"/>
                            <TextBlock Style="{StaticResource HelpText}" Text="The email must be a mailbox IEMAS already watches, and the Server URL must be correct. Your administrator can check both."/>
                            <TextBlock Style="{StaticResource HelpText}" Text="For anything else, contact your IEMAS administrator and mention the version shown in Settings."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Settings -->
            <StackPanel x:Name="SettingsPanel" Visibility="Collapsed" Margin="16">
                <TextBlock Text="Server URL" FontSize="12" Foreground="#4B5563"/>
                <TextBox x:Name="ServerUrlTextBox" Margin="0,4,0,10" Padding="6"/>
                <CheckBox x:Name="AllowInsecureTlsCheckBox" Content="Allow self-signed certificates (dev only)" Margin="0,0,0,10"/>
                <CheckBox x:Name="StartWithWindowsCheckBox" Content="Start with Windows" Margin="0,0,0,14"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Save" Style="{StaticResource ActionButton}" Click="SaveSettingsButton_Click"/>
                    <Button Content="Sign Out / Re-register" Style="{StaticResource SecondaryButton}" Click="SignOutButton_Click"/>
                </StackPanel>
                <TextBlock x:Name="SettingsStatusText" Foreground="#059669" Margin="0,10,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding VersionText}" Foreground="#9CA3AF" FontSize="11" Margin="0,20,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Bottom nav: §9 "Waiting (2)  History  Settings" -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Action Required" Style="{StaticResource TabButton}" Click="ShowActionRequired_Click"
                        ToolTip="Customer inquiries that need something from you now."/>
                <Button x:Name="WaitingTabButton" Content="Waiting" Style="{StaticResource TabButton}" Click="ShowWaiting_Click"
                        ToolTip="Inquiries where you are waiting for a colleague. IEMAS still watches them."/>
                <Button Content="History" Style="{StaticResource TabButton}" Click="ShowHistory_Click"
                        ToolTip="Finished inquiries (not in the app yet; your administrator can see them in IEMAS)."/>
                <Button Content="Open Email" Style="{StaticResource TabButton}" Click="OpenEmail_Click"
                        ToolTip="Opens your email program so you can reply to customers."/>
                <Button Content="Settings" Style="{StaticResource TabButton}" Click="ShowSettings_Click"
                        ToolTip="Server address, start with Windows, sign out."/>
                <Button Content="Help" Style="{StaticResource TabButton}" Click="ShowHelp_Click"
                        ToolTip="How IEMAS works and what each button does."/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
