# Inquiry Supervision stack settings. Copy to inquiry-supervision/.env and fill in.
# Use DIFFERENT secrets from the current system's .env so the two stacks never accept each other's tokens.

POSTGRES_DB=iemas_inq
POSTGRES_USER=iemas
POSTGRES_PASSWORD=change_me

PGADMIN_EMAIL=admin@iemas.com
PGADMIN_PASSWORD=change_me

# openssl rand -base64 48
JWT_SECRET=
# Must differ from JWT_SECRET. openssl rand -base64 48
AGENT_JWT_SECRET=
# openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=

BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

OPENROUTER_API_KEY=
AI_CLASSIFICATION_ENABLED=true

# Host ports. The current system uses 5432 / 8090 / 8091 / 5050, so these must not reuse them.
INQ_POSTGRES_PORT=5433
INQ_API_PORT=8190
INQ_WEB_PORT=8191
INQ_PGADMIN_PORT=5150

# The CMS origin that may call the API. Change it if you open the CMS by IP address or hostname.
CORS_ORIGIN=http://localhost:8191
